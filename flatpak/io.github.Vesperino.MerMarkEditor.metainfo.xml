<component type="desktop-application">
  <id>io.github.Vesperino.MerMarkEditor</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>MerMark Editor</name>
  <summary>Edit Markdown with Mermaid diagrams</summary>

  <developer id="io.github.vesperino">
    <name>Vesperino</name>
  </developer>

  <description>
    <p>
      MerMark Editor is an open-source Markdown editor with built-in Mermaid diagram support.
      Write in a WYSIWYG view or in the raw Markdown source, and your files stay plain .md on your disk.
    </p>
    <ul>
      <li>GitHub Flavored Markdown with tables, task lists, footnotes, math and syntax-highlighted code</li>
      <li>Mermaid flowcharts, sequence, class, state, ER, Gantt and many more diagram types, editable in place</li>
      <li>Marp presentations with a live slide preview and fullscreen present mode</li>
      <li>Multi-root workspaces with a file tree, quick switcher and full-text search</li>
      <li>Split view, tab comparison, change tracking and automatic reload of files changed on disk</li>
      <li>Export to PDF and Word using your chosen document style</li>
      <li>Optional AI assistant for local Ollama models and OpenAI-compatible servers</li>
      <li>English, Polish, German, Chinese and Japanese interface</li>
    </ul>
    <p>
      The Flatpak build runs in a sandbox: Claude Code and Codex CLI installed on the host system are not visible to it.
    </p>
  </description>

  <launchable type="desktop-id">io.github.Vesperino.MerMarkEditor.desktop</launchable>

